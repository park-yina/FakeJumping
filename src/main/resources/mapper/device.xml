<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.parkvina.fakejumping.mapper.DeviceMapper">
    <select
            id="findDevicesPaged"
            resultType="com.parkvina.fakejumping.dto.device.DeviceResult">

        SELECT

        d.id,

        d.device_name AS deviceName,
        d.serial_number AS serialNumber,
        d.device_uuid AS deviceUuid,

        d.device_type AS deviceType,
        d.status AS status,

        d.store_id AS storeId,

        d.last_ping AS lastPing,

        s.name AS storeName

        FROM device d

        LEFT JOIN store s
        ON d.store_id = s.id

        WHERE d.is_active = 1

        <if test="deviceType != null">
            AND d.device_type = #{deviceType}
        </if>

        <!-- 매장 필터 -->
        <if test="storeId != null">
            AND d.store_id = #{storeId}
        </if>

        <!-- 상태 필터 -->
        <choose>

            <!-- ONLINE -->
            <when test='status.name() == "ONLINE"'>

                AND d.last_ping >=
                DATE_SUB(
                NOW(),
                INTERVAL #{onlineSeconds} SECOND
                )

            </when>

            <!-- OFFLINE -->
            <when test='status.name() == "OFFLINE"'>

                AND <![CDATA[
                    (
                        d.last_ping IS NULL
                        OR
                        d.last_ping <
                            DATE_SUB(
                                NOW(),
                                INTERVAL #{onlineSeconds} SECOND
                            )
                    )
                ]]>

            </when>

            <!-- 기타 상태 -->
            <when test="status != null">

                AND d.status = #{status}

            </when>

        </choose>

        <!-- 정렬 -->
        ORDER BY

        <choose>

            <!-- ONLINE -->
            <when test='status.name() == "ONLINE"'>

                d.last_ping DESC

            </when>

            <!-- OFFLINE -->
            <when test='status.name() == "OFFLINE"'>

                d.last_ping ASC

            </when>

            <!-- 기본 -->
            <otherwise>

                d.id DESC

            </otherwise>

        </choose>
        LIMIT #{size} OFFSET #{offset}

    </select>

    <!-- =========================
         DEVICE COUNT
    ========================== -->
    <select
            id="countDevices"
            resultType="int">

        SELECT COUNT(*)

        FROM device d

        WHERE d.is_active = 1

        <!-- 디바이스 타입 -->
        <if test="deviceType != null">
            AND d.device_type = #{deviceType}
        </if>

        <!-- 매장 필터 -->
        <if test="storeId != null">
            AND d.store_id = #{storeId}
        </if>

        <!-- 상태 필터 -->
        <choose>

            <!-- ONLINE -->
            <when test='status.name() == "ONLINE"'>

                AND d.last_ping >=
                DATE_SUB(
                NOW(),
                INTERVAL 30 SECOND
                )

            </when>

            <!-- OFFLINE -->
            <when test='status.name() == "OFFLINE"'>

                AND <![CDATA[
                    (
                        d.last_ping IS NULL
                        OR
                        d.last_ping <
                            DATE_SUB(
                                NOW(),
                                INTERVAL 30 SECOND
                            )
                    )
                ]]>

            </when>

            <!-- 기타 상태 -->
            <when test="status != null">

                AND d.status = #{status}

            </when>

        </choose>

    </select>
    <update id="deactivateDevices">
        UPDATE device
        SET is_active = 0
        WHERE id IN
        <foreach collection="ids"
                 item="id"
                 open="("
                 separator=","
                 close=")">

            #{id}

        </foreach>

    </update>
    <select
            id="findDevicesByIds"
            resultType="com.parkvina.fakejumping.entity.Device">

        SELECT *

        FROM device

        WHERE is_active = 1

        AND id IN

        <foreach collection="ids"
                 item="id"
                 open="("
                 separator=","
                 close=")">

            #{id}

        </foreach>

    </select>

</mapper>