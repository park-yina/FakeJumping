<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parkvina.fakejumping.mapper.AdminMapper">



    <insert id="insertAdmin"
            parameterType="com.parkvina.fakejumping.entity.Admin"
            useGeneratedKeys="true"
            keyProperty="id">

        INSERT INTO admin (
        username,
        password,
        role,
        store_id,
        is_active,
        must_change_password
        )
        VALUES (
        #{username},
        #{password},
        #{role},
        #{storeId},
        #{isActive},
        #{mustChangePassword}
        )

    </insert>
</mapper>